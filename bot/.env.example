# Kuzmix-MD Bot Configuration
# Copy this to .env and fill in your values

# Bot Identity
BOT_NAME=Kuzmix-MD
BOT_DEVELOPER=Oni Oluwatobi
ORGANIZATION=The Kreadive Galaxy
BOT_PREFIX=.
BOT_WATERMARK=⚡ Powered by Kuzmix-MD

# Owner WhatsApp numbers (comma-separated, with country code, no +)
OWNER_NUMBERS=2348143186133,2349124846023

# Bot Mode: public (everyone can use) / private (owners only)
BOT_MODE=public

# Unknown Command Mode: silent / reply / menu
UNKNOWN_MODE=silent

# Session directory (where WhatsApp credentials are stored)
SESSION_DIR=./session

# Gemini API Key (for AI commands, optional)
GEMINI_API_KEY=

# Log level: silent / fatal / error / warn / info / debug / trace
LOG_LEVEL=silent

# IMPORTANT: Set this on Node 24 to prevent "b.mask is not a function" crash
WS_NO_BUFFER_UTIL=1

# Group invite code (auto-join after pairing)
GROUP_INVITE_CODE=IbvPjkzu0Rq69XgmwiAHMA
